generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String    @id @default(uuid()) @db.Uuid
  /// Stored trimmed and lowercased, so the unique index is case-insensitive.
  email           String    @unique
  passwordHash    String    @map("password_hash")
  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  verificationTokens EmailVerificationToken[]
  sessions           Session[]
  tickets            Ticket[]
  comments           Comment[]

  @@map("users")
}

model Team {
  id         String   @id @default(uuid()) @db.Uuid
  /// Trimmed; unique case-insensitively via the expression index "teams_name_lower_key" (see migration).
  name       String
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  /// Set by the application only when the name actually changes.
  modifiedAt DateTime @default(now()) @map("modified_at") @db.Timestamptz(3)

  epics   Epic[]
  tickets Ticket[]

  @@map("teams")
}

model Epic {
  id          String   @id @default(uuid()) @db.Uuid
  /// Fixed at creation; epics never move between teams.
  teamId      String   @map("team_id") @db.Uuid
  /// Trimmed, non-empty (CHECK in migration).
  title       String
  /// Trimmed; empty is stored as NULL.
  description String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  /// Set by the application only when title or description actually change.
  modifiedAt  DateTime @default(now()) @map("modified_at") @db.Timestamptz(3)

  team    Team     @relation(fields: [teamId], references: [id], onDelete: Restrict)
  tickets Ticket[]

  @@index([teamId])
  @@map("epics")
}

enum TicketType {
  bug
  feature
  fix

  @@map("ticket_type")
}

enum TicketState {
  new
  ready_for_implementation
  in_progress
  ready_for_acceptance
  done

  @@map("ticket_state")
}

model Ticket {
  id          String      @id @default(uuid()) @db.Uuid
  teamId      String      @map("team_id") @db.Uuid
  /// Null or an epic of the same team (service check + trigger "tickets_epic_same_team").
  epicId      String?     @map("epic_id") @db.Uuid
  type        TicketType
  state       TicketState @default(new)
  /// Trimmed, non-empty (CHECK in migration).
  title       String
  /// Stored as entered (Markdown indentation matters); must contain non-whitespace (CHECK).
  body        String
  createdById String      @map("created_by") @db.Uuid
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  /// Set by the application only on real field/state changes. Comments never touch it.
  modifiedAt  DateTime    @default(now()) @map("modified_at") @db.Timestamptz(3)

  team      Team  @relation(fields: [teamId], references: [id], onDelete: Restrict)
  epic      Epic? @relation(fields: [epicId], references: [id], onDelete: Restrict)
  createdBy User  @relation(fields: [createdById], references: [id], onDelete: Restrict)
  comments  Comment[]

  @@index([teamId, modifiedAt(sort: Desc)])
  @@index([epicId])
  @@map("tickets")
}

/// Immutable once created (no update/delete in the mandatory scope).
model Comment {
  id        String   @id @default(uuid()) @db.Uuid
  ticketId  String   @map("ticket_id") @db.Uuid
  authorId  String   @map("author_id") @db.Uuid
  /// Stored as entered; must contain non-whitespace (CHECK in migration).
  body      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  /// Deleting a ticket deletes its comments.
  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author User   @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([ticketId, createdAt])
  @@map("comments")
}

model Session {
  /// SHA-256 of the session cookie value.
  id        String   @id
  userId    String   @map("user_id") @db.Uuid
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model EmailVerificationToken {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  /// SHA-256 of the token; the raw token only exists in the emailed link.
  tokenHash     String    @unique @map("token_hash")
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt        DateTime? @map("used_at") @db.Timestamptz(3)
  /// Set when a newer token is issued for the same user.
  invalidatedAt DateTime? @map("invalidated_at") @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_verification_tokens")
}
