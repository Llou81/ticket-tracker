# Copy to .env and adjust. Every value has a default in docker-compose.yml,
# so a clean checkout starts without a .env file.

# Host port the app is served on: http://localhost:${APP_PORT}
APP_PORT=8080

# PostgreSQL (local container only; not exposed to the host)
POSTGRES_DB=ticketing
POSTGRES_USER=ticketing
POSTGRES_PASSWORD=change-me-local-only
