# Copy to .env and adjust. Every value has a default in compose.yaml,
# so a clean checkout starts without a .env file.

# Host port the app is served on: http://localhost:${APP_PORT}
APP_PORT=8080

# Public URL used in verification email links (defaults to http://localhost:${APP_PORT})
# APP_BASE_URL=http://localhost:8080

# PostgreSQL (local container only; not exposed to the host)
POSTGRES_DB=ticketing
POSTGRES_USER=ticketing
POSTGRES_PASSWORD=change-me-local-only

# SMTP for verification emails. Default: DataArt relay.
SMTP_HOST=relay1.dataart.com
SMTP_PORT=25
# true = implicit TLS (usually port 465); false = plain/STARTTLS
SMTP_SECURE=false
# Leave empty if the relay needs no authentication
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Ticket Tracker <no-reply@ticket-tracker.local>

# --- Local testing without a real relay: catch all mail in Mailpit (http://localhost:8025)
# COMPOSE_PROFILES=mail
# SMTP_HOST=mailpit
# SMTP_PORT=1025
